{
    "organism": {
        "name": "Orbital Organism",
        "version": "0.2"
    },

    "world": {
        "mode": "solar_system",
        "_available_modes": ["solar_system", "proxima", "alpha_centauri"]
    },

    "modules": {
        "neural_learner": {
            "enabled": true,
            "parameters": {
                "enabled": true,
                "hidden_width": 24,
                "learning_rate": 0.003,
                "batch_size": 32,
                "steps_per_cycle": 4,
                "validation_size": 128,
                "save_every": 100,
                "max_training_seconds": 0.02
            }
        },

        "orbit_observer": {
            "enabled": true,

            "parameters": {
                "display": true,
                "simulation_days_per_second": 10.0,
                "_speed_note": "Sized against Proxima d (5.1-day period, tightest orbit in any active world mode): ~13 ticks/orbit at this speed, comfortable margin above aliasing risk for the learner's previous->current position training pairs. Press 't' in the running app to snap to true real-time.",
                "trail_length": 1000
            },

            "budget": {
                "cpu_seconds": 0.25,
                "memory_mb": 128,
                "wall_seconds": 0.25
            }
        }
    },

    "organic_budget": {
        "fidelity_level": 0,
        "max_fidelity_level": 3,
        "budget_cpu_ms_per_frame": 30.0,
        "budget_memory_mb": 256.0,
        "upgrade_if_improvement_pct": 0.05,
        "try_upgrade_every_n_generations": 10
    },

    "providers": {
        "local_cpu": {
            "enabled": true,
            "role": "coordinator + renderer",
            "resource_cap_pct": 35
        },

        "tanzania": {
            "enabled": true,
            "address": null,
            "role": "worker: training + code synthesis",
            "resource_cap_pct": 100,
            "_note": "Reachable via SSH host alias 'tanzania' (~/.ssh/config, key-based). Real dispatch: tools/dispatch_tanzania.py, run out-of-band from the render loop."
        },

        "tina": {
            "enabled": true,
            "address": null,
            "role": "worker: validation + backup",
            "resource_cap_pct": 100,
            "_note": "SSH host alias 'tina' configured but currently unreachable (DNS did not resolve as of 2026-09-21 -- likely just offline/asleep, not misconfigured)."
        },

        "ariana": {
            "enabled": true,
            "address": null,
            "role": "opportunistic booster + archival",
            "intermittent": true,
            "resource_cap_pct": 80
        }
    }
}

