{
    "organism": {
        "name": "Orbital Organism",
        "version": "0.2"
    },

    "modules": {
        "neural_learner": {
            "enabled": true,
            "parameters": {
                "enabled": true,
                "hidden_width": 24,
                "learning_rate": 0.003,
                "batch_size": 32,
                "steps_per_cycle": 4,
                "validation_size": 128,
                "save_every": 100,
                "max_training_seconds": 0.02
            }
        },

        "orbit_observer": {
            "enabled": true,

            "parameters": {
                "display": true,
                "simulation_days_per_second": 2.0,
                "trail_length": 1000
            },

            "budget": {
                "cpu_seconds": 0.25,
                "memory_mb": 128,
                "wall_seconds": 0.25
            }
        }
    },

    "organic_budget": {
        "fidelity_level": 0,
        "max_fidelity_level": 3,
        "budget_cpu_ms_per_frame": 30.0,
        "budget_memory_mb": 256.0,
        "upgrade_if_improvement_pct": 0.05,
        "try_upgrade_every_n_generations": 10
    },

    "providers": {
        "local_cpu": {
            "enabled": true,
            "role": "coordinator + renderer",
            "resource_cap_pct": 35
        },

        "tanzania": {
            "enabled": false,
            "address": null,
            "role": "worker: training + code synthesis",
            "resource_cap_pct": 100
        },

        "tina": {
            "enabled": false,
            "address": null,
            "role": "worker: validation + backup",
            "resource_cap_pct": 100
        },

        "ariana": {
            "enabled": false,
            "address": null,
            "role": "opportunistic booster + archival",
            "intermittent": true,
            "resource_cap_pct": 80
        }
    }
}

